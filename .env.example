# Supabase Credentials (from Project Settings > API)
# ضع هذه القيم في .env.local محلياً، أو في Vercel > Settings > Environment Variables.
# استخدم المفتاح العام (anon / publishable) فقط. لا تضع أبداً service_role أو أي مفتاح سري
# في متغير يبدأ بـ VITE_ لأن كل متغيرات VITE_ تُضمَّن في حزمة JavaScript العامة.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
